; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DEAD AISLE"
config/description="Bodycam survival FPS - native Godot port of dead-aisle.html"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/default_filters/anisotropic_filtering_level=4
scaling_3d/mode=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.05, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssil/quality=1
environment/ssil/half_size=true
environment/screen_space_reflection/roughness_quality=1
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
